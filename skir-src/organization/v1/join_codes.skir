import { Duration } from "kernel/v1/duration.skir";
import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";

// JoinCode represents a code that can be used to request to join an organization.
struct JoinCode {
  code: RecordId;
  created_at: timestamp;
  expires_at: timestamp?;
  single_use: bool;
  auto_accept: struct {
    role_ids: [RecordId];
  };
}

struct OrganizationJoinCodesSnapshot {
  sequence: int64;
  values: [JoinCode];
}

enum OrganizationJoinCodesChange {
  add: JoinCode;
  remove: RecordId;
}

struct OrganizationJoinCodesChanged {
  sequence: int64;
  operation_id: string;
  changes: [OrganizationJoinCodesChange];
}

method WatchOrganizationJoinCodes(
  struct {}
): enum {
  internal_error: InternalError;

  snapshot: OrganizationJoinCodesSnapshot;
  changed: OrganizationJoinCodesChanged;
} = 690316;

method GenerateOrganizationJoinCode(
  struct {
    operation_id: string;
    single_use: bool;
    expiration: enum {
      never;
      duration: Duration;
    };
    auto_accept: struct {
      role_ids: [RecordId];
    };
  }
): enum {
  invalid_operation_id_error: struct {};
  operation_identity_reused_error: struct {};
  internal_error: InternalError;

  success: struct {
    code: JoinCode;
    event: OrganizationJoinCodesChanged;
  };

  roles_not_found_error: struct {
    role_ids: [RecordId];
  };
  roles_not_assignable_error: struct {
    role_ids: [RecordId];
  };
  invalid_expiration_error: struct {
    duration: Duration;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 804958;

method RevokeOrganizationJoinCode(
  struct {
    operation_id: string;
    code_id: RecordId;
  }
): enum {
  invalid_operation_id_error: struct {};
  operation_identity_reused_error: struct {};
  internal_error: InternalError;

  success: struct {
    event: OrganizationJoinCodesChanged;
  };

  code_not_found_error: struct {
    code_id: RecordId;
  };

  invalid_record_id_error: InvalidRecordIdError;
} = 510187;
