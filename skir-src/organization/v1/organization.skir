import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";

struct Organization {
  organization_id: RecordId;
  name: string;
  logo_url: string;
}

method CreateOrganization(
  struct {
    operation_id: string;
    name: string;
    logo_url: string?;
  }
): enum {
  invalid_operation_id_error: struct {};
  operation_identity_reused_error: struct {};
  internal_error: InternalError;

  success: Organization;
} = 336038;

method DeleteOrganization(
  struct {
    organization_id: RecordId;
  }
): enum {
  internal_error: InternalError;

  success: struct {};

  invalid_record_id_error: InvalidRecordIdError;
} = 627251;
