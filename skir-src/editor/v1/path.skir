import { TypedValue } from "editor/v1/type_catalog.skir";

// Data paths address nested values inside a typed editor value. The empty
// segment list is the root. Paths are used consistently for binding targets,
// diagnostics, conversions, and incremental editor changes.

struct FieldPathSegment(810400001) {
  field_name: string = 0;
}

struct IndexPathSegment(810400002) {
  index: int32 = 0;
}

struct MapKeyPathSegment(810400003) {
  key: TypedValue = 0;
}

enum DataPathSegment(810400004) {
  field: FieldPathSegment = 1;
  index: IndexPathSegment = 2;
  map_key: MapKeyPathSegment = 3;
}

struct DataPath(810400005) {
  segments: [DataPathSegment] = 0;
}
