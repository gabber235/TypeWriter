// Stable identity for a page kind. Consumers encode the canonical declared type identity as text.
// The identity does not include a revision.
struct PageKindId {
  value: string;
}

// Selects one compatible page kind implementation by identity and positive revision.
// Equality includes both parts, so a revision change is a distinct implementation contract.
struct PageKindRef {
  id: PageKindId;
  revision: int32;
}
