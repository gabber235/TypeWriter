import {
  InternalError,
  InvalidRecordIdError,
} from "kernel/v1/errors.skir";
import { RecordId } from "kernel/v1/record_id.skir";
import { Service } from "service/v1/service.skir";

// Validation failures for organization owned service metadata. These are rejected without changing the service
// revision or publishing a service update.
enum ServiceUpdateValidationError {
  name_invalid;
}

// Streams the organization service projection for the addressed organization.
// The initial list is a snapshot. Later add, update, and remove variants describe committed binding, metadata, or
// liveness changes. A service is visible here only while organization bound; this watch does not expose unbound
// registration leases.
method WatchOrganizationServices(
  struct {}
): enum {
  internal_error: InternalError;

  list: [Service];
  add: Service;
  update: Service;
  remove: RecordId;
} = 820326;

// Performs an organization scoped compare and set update of service metadata.
// The registration service owns revision and increments it only after accepting the name change. A stale expected
// revision returns the current service in conflict_error, while service_not_found_error means the service is absent
// from this organization. Operation identity protects retries and rejects reuse with different input.
method UpdateOrganizationService(
  struct {
    operation_id: string;
    service_id: RecordId;
    expected_revision: int64;
    name: string;
  }
): enum {
  internal_error: InternalError;

  success: Service;

  conflict_error: struct {
    expected_revision: int64;
    actual: Service;
  };

  service_not_found_error: struct {};

  validation_error: ServiceUpdateValidationError;

  invalid_operation_id_error: struct {};
  operation_identity_reused_error: struct {};
  invalid_record_id_error: InvalidRecordIdError;
} = 872501;
